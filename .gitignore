
# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE and editor files
.vscode/
.idea/
.cursor/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/*
!logs/.gitkeep

# Temporary files
*.tmp
*.bak
*.swp

# ChromaDB persistent vector database
data/chroma/
chroma_db/

# Generated model/cache files
.cache/
sentence_transformers/

# Build and distribution
build/
dist/
*.egg-info/

# Keep generated evaluation evidence and transcripts
# Do not ignore reports/ or transcripts/

.flake8
